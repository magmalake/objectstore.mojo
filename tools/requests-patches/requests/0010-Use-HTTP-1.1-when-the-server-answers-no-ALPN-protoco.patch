From a040e47f9a1cb1fd78cb2428a4fdf16fc20e1d28 Mon Sep 17 00:00:00 2001
From: Marius S <39998+winding-lines@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:23:02 -0800
Subject: [PATCH 10/10] Use HTTP/1.1 when the server answers no ALPN protocol,
 without an HTTP/2 probe

With no ALPN answer the client sent the HTTP/2 preface over the new TLS
connection and, when that failed, made a second TCP+TLS connection for
HTTP/1.1. HTTP/2 over TLS is only negotiated through ALPN (RFC 9113
3.2), so the probe never finds h2, and it doubled the handshakes for
every TLS 1.2 server (tls reports no ALPN result for 1.2) and for TLS
1.3 servers without h2: one GET to sha256.badssl.com or to Azure Blob
Storage opened 2 connections. Now 1.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 alpn_test_server.py     | 36 ++++++++++++++++++++
 http_client.mojo        | 73 +++++++++++------------------------------
 pixi.toml               |  1 +
 test_alpn_fallback.mojo | 30 +++++++++++++++++
 4 files changed, 87 insertions(+), 53 deletions(-)
 create mode 100644 alpn_test_server.py
 create mode 100644 test_alpn_fallback.mojo

diff --git a/alpn_test_server.py b/alpn_test_server.py
new file mode 100644
index 0000000..8b4d7d6
--- /dev/null
+++ b/alpn_test_server.py
@@ -0,0 +1,36 @@
+"""HTTPS test server that negotiates no ALPN protocol (like TLS 1.2 servers
+and HTTP/1.1-only TLS 1.3 servers). Serves keep-alive HTTP/1.1.
+
+Usage: python alpn_test_server.py <cert.pem> <key.pem> [port]
+"""
+import http.server
+import ssl
+import sys
+
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+
+    def do_GET(self):
+        body = b"ok"
+        self.send_response(200)
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, *args):
+        pass
+
+
+def main():
+    cert, key = sys.argv[1], sys.argv[2]
+    port = int(sys.argv[3]) if len(sys.argv) > 3 else 18443
+    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+    ctx.load_cert_chain(cert, key)  # no set_alpn_protocols: no ALPN answer
+    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
+    server.socket = ctx.wrap_socket(server.socket, server_side=True)
+    server.serve_forever()
+
+
+if __name__ == "__main__":
+    main()
